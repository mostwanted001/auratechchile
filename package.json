{
  "name": "aura-tech",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && cp dist/aura-tech/browser/index.csr.html dist/aura-tech/browser/404.html",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev": "node --env-file=.env node_modules/@angular/cli/bin/ng.js serve",
    "serve:ssr:aura-tech": "node dist/aura-tech/server/server.mjs",
    "build:local": "node --env-file=.env node_modules/@angular/cli/bin/ng.js build && cp dist/aura-tech/browser/index.csr.html dist/aura-tech/browser/404.html"
  },
  "private": true,
  "packageManager": "yarn@1.22.19",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.5",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.162.0"
  }
}
